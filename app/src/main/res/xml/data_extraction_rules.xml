<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (Android 12+ cloud backup & device-to-device transfer).
   The admin session file holds Supabase access/refresh tokens and must never leave
   the device via backup or transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="btbd_admin_session_secure.xml" />
        <exclude domain="sharedpref" path="btbd_admin_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="btbd_admin_session_secure.xml" />
        <exclude domain="sharedpref" path="btbd_admin_session.xml" />
    </device-transfer>
</data-extraction-rules>
